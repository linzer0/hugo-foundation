# Hugo
public/
public-*/
resources/_gen/
.hugo_build.lock

# The site's build output and scratch destinations. `hugo --source site
# --destination <dir>` puts <dir> inside site/ when given a bare name, so the
# Hugo patterns above do not cover it. These were committed once already
# (090d87e carried site/tmp-site/ and site/tmp-site-pm/, 46 files of generated
# HTML, CSS and JS); the rules below exist so that cannot happen twice.
site/public/
site/public-*/
site/tmp-*/
tmp-*/

# The fixture's image-processing cache. `resources/_gen/` above is anchored to
# the repository root — a pattern with a slash inside it does not match at
# depth — so the fixture's own cache was neither ignored nor absent, and
# appeared the moment the gallery fixture grew a real image to resize.
fixtures/demo/resources/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp/site/tmp-*/
/site/public/
/site/public-*/
/site/resources/
